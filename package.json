{
  "name": "hippo-cache",
  "version": "1.0.0",
  "description": "Scientifically grounded, token-frugal cognitive memory engine for AI coding agents (Claude Code, Codex CLI, Cursor, Windsurf, Antigravity). ACT-R activation decay, HippoRAG Personalized PageRank, bi-temporal contradiction resolution, and submodular knapsack packing on local SQLite.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "hippo-cache": "./bin/hippo-cache.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./engine": "./src/core/engine.js",
    "./mcp": "./src/mcp/server.js",
    "./http": "./src/server/http.js"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning ./bin/hippo-cache.js serve",
    "mcp": "node --no-warnings=ExperimentalWarning ./bin/hippo-cache.js mcp",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "bench": "node --no-warnings=ExperimentalWarning benchmarks/run.mjs",
    "assets": "node --no-warnings=ExperimentalWarning scripts/generate-assets.mjs"
  },
  "keywords": [
    "ai-agent",
    "agent-memory",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor",
    "hipporag",
    "act-r",
    "personalized-pagerank",
    "knowledge-graph",
    "token-optimization",
    "sqlite",
    "submodular-optimization",
    "bi-temporal"
  ],
  "author": "RAFBUG <128036625+Moeraafatz@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Moeraafatz/hippo-cache.git"
  },
  "homepage": "https://github.com/Moeraafatz/hippo-cache#readme"
}
